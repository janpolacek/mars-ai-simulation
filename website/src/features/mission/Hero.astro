---
import { Image } from 'astro:assets';

import { identityMark } from '../../lib/assets';
---

<section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Fictional mission // AI-assisted project</p>
        <h1 id="hero-title">A mission to read Mars carefully.</h1>
        <p class="hero-summary">
            Red Horizon follows a fictional international coalition as it works through the real questions behind a
            robotic Mars expedition: what to build, where to go, and how to make decisions with evidence.
        </p>
        <a class="text-link" href="#updates">Read the first announcement <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-mark" aria-hidden="true">
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <Image src={identityMark} alt="" width={896} height={896} format="webp" />
    </div>
</section>

<style>
.hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
    align-items: center;
    gap: 4rem;
    min-height: 38rem;
    padding: 5.5rem 0 5rem;
}

h1 {
    max-width: 39rem;
}

.hero-summary {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: var(--rh-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
}

.text-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 2rem;
    border-bottom: 1px solid rgba(252, 160, 66, 0.5);
    padding-bottom: 0.45rem;
    color: var(--rh-sun-core);
    font-size: 0.83rem;
    font-weight: 750;
    text-decoration: none;
}

.text-link:hover,
.text-link:focus-visible {
    color: var(--rh-sun-core);
}

.hero-mark {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 28rem;
}

.hero-mark img {
    position: relative;
    z-index: 1;
    width: min(100%, 28rem);
    height: auto;
    filter: drop-shadow(0 2rem 3rem rgba(160, 48, 29, 0.18));
}

.hero-orbit {
    position: absolute;
    border: 1px solid rgba(123, 167, 250, 0.32);
    border-radius: 50%;
    transform: rotate(-22deg);
}

.orbit-one {
    width: 90%;
    height: 45%;
}

.orbit-two {
    width: 73%;
    height: 75%;
    transform: rotate(50deg);
    border-color: rgba(252, 160, 66, 0.22);
}

@media (max-width: 760px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 1rem;
        min-height: auto;
        padding: 4rem 0 4.5rem;
    }

    .hero-mark {
        min-height: 19rem;
        order: -1;
    }

    .hero-mark img {
        width: min(78vw, 20rem);
    }
}
</style>
