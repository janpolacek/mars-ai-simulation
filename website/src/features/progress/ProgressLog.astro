---
import SectionHeading from '../../components/SectionHeading.astro';
import { progressHeading, progressSteps } from './steps';
---

<section class="progress-section" id="timeline" aria-labelledby="timeline-title">
    <div class="progress-heading">
        <SectionHeading
            eyebrow={progressHeading.eyebrow}
            title={progressHeading.title}
            titleId="timeline-title"
            description={progressHeading.description}
        />
    </div>
    <ol class="timeline-list">
        {progressSteps.map((step) => (
            <li class={step.current ? 'is-current' : undefined}>
                <div class="timeline-marker"><span></span></div>
                <div>
                    <p class="timeline-state">{step.state}</p>
                    <h3>{step.title}</h3>
                    <p class="timeline-detail">{step.detail}</p>
                    {step.link && <p class="timeline-link"><a href={step.link.href}>{step.link.label}</a></p>}
                </div>
            </li>
        ))}
    </ol>
</section>

<style>
.progress-section {
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
    gap: 4rem;
    border-top: 1px solid var(--rh-hairline);
    padding: 7rem 0;
}

.timeline-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
}

.timeline-list li {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.2rem;
    min-height: 8.5rem;
    padding-bottom: 2rem;
}

.timeline-list li:not(:last-child)::after {
    position: absolute;
    top: 1.1rem;
    bottom: 0;
    left: 0.47rem;
    border-left: 1px solid var(--rh-hairline-soft);
    content: '';
}

.timeline-marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    margin-top: 0.25rem;
    border: 1px solid var(--rh-earth-blue);
    border-radius: 50%;
    background: var(--rh-void-black);
}

.timeline-marker span {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--rh-earth-blue);
}

.timeline-list li.is-current .timeline-marker {
    border-color: var(--rh-sun-core);
    box-shadow: 0 0 0 0.4rem rgba(252, 160, 66, 0.12);
}

.timeline-list li.is-current .timeline-marker span {
    background: var(--rh-sun-core);
}

.timeline-state {
    margin: 0 0 0.55rem;
    color: var(--rh-sun-core);
}

.timeline-list h3 {
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    letter-spacing: -0.04em;
}

/*
 * The detail paragraph carries its own class instead of the positional
 * `p:last-child` this rule used to key on: the linked step renders a link
 * paragraph after its detail, and a positional selector left that one detail
 * in the primary text colour at the full column width while its two
 * neighbours stayed muted and measured (16px / rgb(255, 248, 232) / 636px
 * against 15.2px / rgb(220, 198, 177) / 480px on the built page). Every step's
 * detail now matches on font-size, colour and measure.
 */
.timeline-detail {
    max-width: 30rem;
    margin: 0.7rem 0 0;
    color: var(--rh-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
}

/*
 * The optional link to the published article that carries the step. Small
 * label type at the muted scale, with the accent underline-and-hover
 * treatment `a.card-label` carries in `NewsCard.astro`.
 */
.timeline-link {
    margin: 0.75rem 0 0;
    color: var(--rh-text-muted);
    font-size: var(--rh-label-size);
    font-weight: var(--rh-label-weight);
    letter-spacing: var(--rh-label-tracking);
    line-height: 1.3;
    text-transform: uppercase;
}

.timeline-link a {
    border-bottom: 1px solid rgba(252, 160, 66, 0.5);
    padding-bottom: 0.2rem;
    color: var(--rh-sun-core);
    text-decoration: none;
}

.timeline-link a:hover,
.timeline-link a:focus-visible {
    color: var(--rh-text-primary);
}

@media (max-width: 760px) {
    .progress-section {
        grid-template-columns: 1fr;
        gap: 2.75rem;
        padding: 4.5rem 0;
    }
}
</style>
