---
import { getImage, Image } from 'astro:assets';

import { routes } from '../../lib/navigation';
import { simulatedDateText } from '../../lib/simulated-date';
import { resolveNewsMedia } from './media';
import { plateAltText } from './plates';

/**
 * One news card. `index` is its position in the list (placeholder number and
 * eager/lazy loading), `active` is whether it is currently shown — a carousel
 * passes `false` for the slides it hides.
 *
 * The card carries one image, so a multi-plate set leads with its first plate
 * (AF-01, the locator) and is labelled with that plate's label rather than the
 * set label, which describes three plates the card does not show.
 *
 * `headingLevel` is the element the card title renders as, with the same split
 * `SectionHeading` documents: `2` when the card sits directly under the route's
 * own `h1` (the newsroom index, `NewsList`), `3` when it sits inside a section
 * that already carries an `h2` (the homepage carousel).
 */
const { item, index, active = true, headingLevel = 3 } = Astro.props;
const media = resolveNewsMedia(item.data.media);
const leadPlate = media?.plates[0];
const cardLabel = media && media.plates.length > 1 ? leadPlate?.label : item.data.mediaLabel;
/**
 * The cell's fill: the same plate at the same transform the `<Image>` below
 * renders, so the leftover area is the plate's own colours and the extension
 * costs no second file (the built page points both at one emitted asset).
 *
 * `getImage` is used instead of a second `<Image>` because the fill is a CSS
 * background on the cell, not a second rendered element: nothing has to be
 * lazy-loaded or promoted for it, and the cell's own markup stays one image.
 */
const plateFill = leadPlate
    ? (await getImage({ src: leadPlate.src, width: 1024, format: 'webp' })).src
    : undefined;
const plateFillStyle = plateFill ? `--plate-fill: url('${plateFill}')` : undefined;
/**
 * Every item this component renders comes from the published query (`./query.ts`),
 * which is the same predicate the detail route is generated from, so the label can
 * always be a real link: `/news/<slug>/` exists for every listed card. The
 * `a.card-label` styles below carry the hover and `:focus-visible` treatment.
 */
const articleHref = routes.newsArticle(item.id);
/**
 * The simulated record date, in the same wording the article page states (one
 * module owns it), or `undefined` for an item that has none — the card then
 * renders no line at all, so a card can never show a date its article does not.
 * It sits under the summary, beside the card's link, where the card's metadata
 * ends: the reader sees it without it displacing the teaser's own text.
 */
const simulatedDate = item.data.simulatedDate ? simulatedDateText(item.data.simulatedDate) : undefined;
---

<article
    class:list={['news-card', active && 'is-active']}
    data-slide={index}
    aria-hidden={active ? 'false' : 'true'}
    hidden={active ? undefined : true}
>
    {media && leadPlate ? (
        <div class="news-image" style={plateFillStyle}>
            <Image
                src={leadPlate.src}
                alt={plateAltText({ value: item.data.mediaAlt, plates: media.plates, index: 0 })}
                width={1024}
                format="webp"
                loading={index === 0 && active ? 'eager' : 'lazy'}
            />
            <span class="image-label">{cardLabel}</span>
        </div>
    ) : undefined}
    <div class="news-copy">
        <p class="card-kicker">{item.data.category} <span>·</span> {item.data.status}</p>
        {headingLevel === 2 ? <h2>{item.data.title}</h2> : <h3>{item.data.title}</h3>}
        <p>{item.data.summary}</p>
        {simulatedDate && <p class="news-date">{simulatedDate}</p>}
        <a class="card-label" href={articleHref}>{item.data.linkLabel}</a>
    </div>
</article>

<style>
.news-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
    min-height: 27rem;
    background: var(--rh-surface-field);
}

/*
 * The carousel's shared cell, scoped to the carousel: `NewsCarousel.astro` makes
 * `.news-carousel` a grid and every slide is placed in its single cell, so the
 * section is exactly as tall as the tallest published slide and its box does not
 * change when the reader switches slides. A published set of one is the same
 * shape with one item.
 *
 * It has to stay scoped, because this card renders on two surfaces. As a bare
 * `.news-card` rule the placement also applied on the newsroom index, where the
 * card is a grid item of `NewsList`'s own `.news-index-list` (`display: grid;
 * gap: 2rem`): measured on a build of `origin/main` (2026-09-17) at 1280x800,
 * both cards were in row 1 / column 1, the list measured one card tall
 * (644.562px, list 645px) and the second card painted underneath the first
 * (document 1295px), so the page was exactly one card tall whichever card it
 * showed.
 *
 * `:global()` here is the other way round from the usual scoped-CSS trap: the
 * element being placed is this file's own `.news-card`, and the ancestor that
 * makes the placement mean "one cell across all slides" is written in
 * `NewsCarousel.astro`.
 */
:global(.news-carousel) .news-card {
    grid-area: 1 / 1;
}

/*
 * An inactive slide must not change the carousel's height, so it stays in the
 * flow: `display: grid` is restated here rather than leaning on this component's
 * class rule beating the UA's `[hidden] { display: none }`, and the box is made
 * invisible with `visibility` instead. Measured on the built homepage before this
 * rule (two published items, 1280px): `display: none` handed the height back to
 * whichever card was active — 461px for slide 0 against 645px for slide 1, a
 * 184px jump of the whole document per switch (card `t_89b325e5`).
 *
 * This keeps the accessibility fix the rule it replaces carried. `display: grid`
 * beats the UA's `[hidden]` rule (an author rule outranks the user-agent sheet),
 * so the attribute alone never removed the slide: it stayed rendered and its
 * `/news/<slug>/` link stayed in the tab order. `visibility: hidden` takes the
 * slide out of the paint, the tab order and the accessibility tree, while
 * `hidden` and `aria-hidden="true"` stay on the element too. Verified on the
 * built page: Tab skips the inactive slide's link, and it is absent from the
 * accessibility tree.
 *
 * The cost, measured, and what it needs: the hidden slide keeps its box, so its
 * `loading="lazy"` image sits inside the viewport once the section is on screen
 * — but Chromium does not fetch an image inside a `visibility: hidden` subtree
 * (measured on the built page with a 1280x3200 viewport covering the whole
 * section: the hidden slide's illustration was never requested), and showing the
 * slide changes no geometry, so nothing re-triggers the decision either
 * (measured: the picture stayed blank after the switch). `carousel.client.ts`
 * therefore promotes the image of the slide it shows to `loading="eager"`, which
 * does start the fetch (measured). The section keeps one height without a
 * literal value, and an illustration is fetched when the reader asks for its
 * slide.
 */
.news-card[hidden] {
    display: grid;
    visibility: hidden;
}

/*
 * One cell for an image, so the carousel's height
 * (card `t_89b325e5`) does not depend on which it holds.
 *
 * The cell's own fill is never `--rh-surface-plate`: that pale paper tone
 * (#eeebe5) showed as a band above and below every plate whose ratio was not
 * the cell's — 215px of a 645x645 cell at 1280x800, which a reader sees as a
 * white background (card `t_f97d6184`). The image cell takes the section's own
 * field as its fallback instead, and paints the plate over it below;
 * there is no placeholder anymore.
 */
.news-image {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
}

/*
 * A designed landscape cell for the carousel, one shape for every slide above
 * the phone breakpoint (card `t_e4cc3b9f`).
 *
 * Without it the cell is sized by the ratio of whatever plate it holds: the
 * `min-height` above is a floor, the image is `width: 100%; height: 100%` and
 * nothing bounds the box, so a square plate at the media column's full width
 * makes the cell square — and the one-height contract above (`grid-area: 1 / 1`)
 * hands that height to the whole section. Measured on the built homepage,
 * 1600x900: `.news-carousel` 745.2px tall (a 745.2px box drawing the 3:2 area
 * plate 497px tall, so 248px — 33% — of the visible box was `--plate-fill`, not
 * artwork), section 1185px against a 900px screen.
 *
 * 3:2 is the shape of the widest plate the newsroom publishes (the
 * `asteria-field` area plates are 1024x683 = 1.499): the cell takes that ratio,
 * contains every other plate inside it (`object-fit: contain`, so nothing the
 * image's own `alt` names is cropped) and lets `--plate-fill` cover the
 * remainder. Any plate wider than 3:2 would still force the box taller, which is
 * why the shape is the *widest* plate family's ratio rather than a height fitted
 * to today's three cards.
 *
 * It is a ratio, not a height: the box still grows with a longer summary or a
 * third article, because the card's copy column is the taller half at every
 * width measured (1280x800: copy 460.8px against a 429.9px cell; 1024x800:
 * 453.8 against 331.6). Above the breakpoint the section's height is therefore
 * set by the copy, not by the plate ratio.
 *
 * Scoped to the carousel on purpose. On the newsroom index the card is a grid
 * item of `.news-index-list` and each of its cells is sized by its own plate, so
 * a bounded shape there would give the square and 4:3 cards the very band
 * `t_f97d6184` removed (measured on `/news/` at 1280x800: cells 586.1 / 644.6 /
 * 527.1 tall, the square one filled by its plate to 0px of band, while their
 * rule is shared). `:global()` is the same shape this file already uses for the
 * shared cell below: the element is this file's own, only the ancestor is
 * reached.
 */
:global(.news-carousel) .news-image {
    aspect-ratio: 3 / 2;
    /*
     * A definite width, so the ratio decides the cell's *height* and nothing
     * else. With the width left `auto` the ratio resolves it from the definite
     * `min-height` above instead (352px x 3/2 = 528px when the floor binds), and
     * the cell then paints past its column: measured at 1024x800, 528px wide in
     * a 497.4px column, 30.6px over the copy's padding, and 101.9px over it at
     * 900x800 (528 in 426.1). `min-width: 0` keeps the item's automatic minimum
     * size from re-imposing the same width on top of it. The plate is
     * `object-fit: contain` inside a clipping cell, so nothing depends on the
     * cell being wider than its column.
     */
    width: 100%;
    min-width: 0;
}

.news-image {
    background: var(--rh-surface-field);
}

/*
 * The image cell's ground: the plate itself, cropped to cover the cell and
 * blurred, painted behind the plate (which `object-fit: contain` still fits
 * whole, so no label, caption, annotation or arrow is ever cropped).
 *
 * The fill is derived from the plate rather than from a cell size or a
 * per-slide ratio, so it holds at any ratio and at both breakpoints. Cropping
 * the plate to the cell — `object-fit: cover` — was measured and rejected: in
 * this cell it removes the outer 256px of the 1536px plate on each side, which
 * drops the north arrow entirely and truncates the plate's own title bar and
 * target callout box mid-word.
 *
 * `inset: -12%` bleeds the layer past the cell so the blur's soft edge, which
 * fades toward transparent, is clipped by `overflow: hidden` here instead of
 * showing inside the cell.
 */
.news-image::before {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: 0;
    background-image: var(--plate-fill);
    background-position: center;
    background-size: cover;
    filter: blur(28px) brightness(0.6);
}

.news-image img {
    /* Above the fill layer: the plate stays the subject, the fill its ground. */
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.image-label {
    position: absolute;
    z-index: 2;
    right: 1.25rem;
    bottom: 1.15rem;
    max-width: calc(100% - 2.5rem);
    background: rgba(1, 0, 0, 0.78);
    padding: 0.45rem 0.6rem;
    color: var(--rh-text-primary);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.news-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
}

.card-kicker {
    margin: 0 0 1.6rem;
    color: var(--rh-sun-core);
}

.card-kicker span {
    color: var(--rh-text-muted);
}

.news-copy h2,
.news-copy h3 {
    max-width: 24rem;
}

.news-copy p:not(.card-kicker) {
    max-width: 27rem;
    margin: 1.5rem 0 0;
    color: var(--rh-text-muted);
    font-size: 1rem;
    line-height: 1.65;
}

/*
 * The simulated record date's line on the card, in the wording the article page
 * states. Same specificity as the summary rule above and later in the sheet, so
 * it decides its own colour and size without an `!important` or a nested
 * selector; the card's flex column gives it its spacing.
 */
.news-copy p.news-date {
    margin: 1.25rem 0 0;
    color: var(--rh-text-faint);
    font-size: 0.8rem;
    line-height: 1.5;
}

.card-label {
    margin-top: 2rem;
    color: var(--rh-text-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
}

a.card-label {
    border-bottom: 1px solid rgba(252, 160, 66, 0.5);
    padding-bottom: 0.35rem;
    color: var(--rh-sun-core);
    text-decoration: none;
}

a.card-label:hover,
a.card-label:focus-visible {
    color: var(--rh-text-primary);
}

@media (max-width: 760px) {
    .news-card {
        grid-template-columns: 1fr;
    }

    .news-image {
        min-height: 15rem;
    }

    /*
     * The phone breakpoint keeps the cell at the floor it has had, so the
     * stacked card measures exactly as it did before the landscape shape was
     * added (card `t_e4cc3b9f`: 430x844 — carousel 743px, section 1093.6px, the
     * same numbers as the build without the rule). The copy column below
     * (`min-height: 23rem`) is the taller half here, and its height is what the
     * card reads; a ratio on the cell would only take box away from it.
     */
    :global(.news-carousel) .news-image {
        aspect-ratio: auto;
    }

    .news-copy {
        min-height: 23rem;
        padding: 2rem 1.5rem 2.5rem;
    }
}
</style>
