---
import CarouselControls from '../../components/CarouselControls.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsCard from './NewsCard.astro';
import { getPublishedNews } from './query';

// The feature owns its query: the section renders the published set itself.
const items = await getPublishedNews();
---

<section class="news-section" id="updates" aria-labelledby="updates-title">
    <div class="section-heading">
        <SectionHeading eyebrow="Newsroom" title="The story starts before launch." titleId="updates-title" />
        <CarouselControls total={items.length} />
    </div>

    <div class="news-carousel" data-news-carousel aria-roledescription="carousel" aria-label="Red Horizon news">
        {items.map((item, index) => <NewsCard item={item} index={index} active={index === 0} />)}
    </div>
</section>

<script>
import { initNewsCarousel } from './carousel.client';

initNewsCarousel();
</script>

<style>
.news-section {
    padding: 7rem 0;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.75rem;
}

/*
 * The carousel is a grid so that every slide can occupy the same cell
 * (`grid-area: 1 / 1` on `.news-card`): the row is then as tall as the tallest
 * published slide, and the section keeps one height whichever slide is active
 * instead of resizing to the active card on every switch (card `t_89b325e5`).
 * No literal height is involved, so a longer summary or a third article needs no
 * change here, at either breakpoint.
 */
.news-carousel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
}

@media (max-width: 760px) {
    .news-section {
        padding: 4.5rem 0;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
        margin-bottom: 2rem;
    }
}
</style>
