---
import { Image } from 'astro:assets';

import { plateFigures } from './plates';

/*
 * Two or more plates of one media set: AF-01 locator, AF-02 regional context,
 * AF-03 local operations frame for `asteria-plates`.
 *
 * Alt text comes from the article's frontmatter, one entry per plate. The
 * caption is composed here so every plate prints its own label, the set's
 * mandatory provenance sentence, and the plate's own safety note: an author
 * cannot publish a plate without them.
 *
 * The plates are large (2.3–3.5 MB PNG sources), so each figure lazy-loads;
 * Astro's asset pipeline hashes and re-encodes them at build time.
 *
 * Props: `set` (the resolved media set, `NewsMediaSet` in `./plates.ts`),
 * `mediaAlt` and `mediaCaption` (frontmatter text, one entry per plate), and
 * `mediaLabel` (the set's label). Declared untyped because the frontmatter here
 * is plain JS: `@typescript-eslint/parser` is not installed, and a `Props`
 * interface or `import type` fails `npm run lint`.
 */
const { set, mediaAlt, mediaCaption, mediaLabel } = Astro.props;

const figures = plateFigures({ set, mediaAlt, mediaCaption });
---

<div class="article-plates">
    {mediaLabel && <p class="article-plates-label">{mediaLabel}</p>}
    {
        figures.map((figure) => (
            <figure class="article-plate">
                <Image src={figure.src} alt={figure.alt} width={1152} format="webp" loading="lazy" />
                <figcaption>{figure.caption}</figcaption>
            </figure>
        ))
    }
</div>

<style>
.article-plates {
    display: flex;
    flex-direction: column;
    max-width: 44rem;
    margin: 3rem 0 0;
    gap: 2.5rem;
}

.article-plates-label {
    margin: 0;
    color: var(--rh-sun-core);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.article-plate {
    margin: 0;
}

.article-plate img {
    display: block;
    width: 100%;
    height: auto;
}

.article-plate figcaption {
    margin-top: 0.85rem;
    color: var(--rh-text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    line-height: 1.6;
    text-transform: uppercase;
}
</style>
