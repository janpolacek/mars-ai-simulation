---
import { getCollection } from 'astro:content';

const identityMark = '/brand/red-horizon-sunrise-mark.png';
const newsItems = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Red Horizon is a fictional, AI-assisted Mars exploration project tracked from first planning to the surface." />
        <meta name="generator" content={Astro.generator} />
        <title>Red Horizon | A Mars mission in progress</title>
    </head>
    <body class="is-loading">
        <div class="splash" id="splash" aria-hidden="true">
            <div class="splash-inner">
                <img src={identityMark} alt="" width="1254" height="1254" />
                <p>Red Horizon</p>
                <span>Mission briefing</span>
            </div>
        </div>

        <main id="main-content" class="page">
            <header class="site-header">
                <a class="wordmark" href="#top" aria-label="Red Horizon home">
                    <img src={identityMark} alt="" width="1254" height="1254" />
                    <span>Red Horizon</span>
                </a>
                <nav aria-label="Primary navigation">
                    <a href="#updates">News</a>
                    <a href="#mission">Mission</a>
                    <a href="#timeline">Progress</a>
                </nav>
            </header>

            <section class="hero" id="top" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <p class="eyebrow">Fictional mission // AI-assisted project</p>
                    <h1 id="hero-title">A mission to read Mars carefully.</h1>
                    <p class="hero-summary">
                        Red Horizon follows a fictional international coalition as it works through the
                        real questions behind a robotic Mars expedition: what to build, where to go, and
                        how to make decisions with evidence.
                    </p>
                    <a class="text-link" href="#updates">Read the first announcement <span aria-hidden="true">↗</span></a>
                </div>
                <div class="hero-mark" aria-hidden="true">
                    <div class="hero-orbit orbit-one"></div>
                    <div class="hero-orbit orbit-two"></div>
                    <img src={identityMark} alt="" width="1254" height="1254" />
                    <span class="hero-coordinate">18° 42′ S<br />226° 14′ E</span>
                </div>
            </section>

            <section class="mission-panel" id="mission" aria-labelledby="mission-title">
                <div class="section-intro">
                    <p class="eyebrow">Mission brief</p>
                    <h2 id="mission-title">The programme at a glance</h2>
                    <p>
                        A clear public record of a fictional Mars mission, from early coalition planning
                        to the work of its first surface vehicle, RH-01 Pathfinder.
                    </p>
                </div>
                <dl class="mission-facts">
                    <div>
                        <dt>Name</dt>
                        <dd>Red Horizon</dd>
                    </div>
                    <div>
                        <dt>Current state</dt>
                        <dd>Coalition planning</dd>
                    </div>
                    <div>
                        <dt>Launch date</dt>
                        <dd>To be announced</dd>
                    </div>
                    <div>
                        <dt>Landing date</dt>
                        <dd>To be announced</dd>
                    </div>
                    <div class="fact-wide">
                        <dt>Objective</dt>
                        <dd>Map local terrain, examine rocks in context, and test careful remote operations on Mars.</dd>
                    </div>
                </dl>
            </section>

            <section class="news-section" id="updates" aria-labelledby="updates-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Newsroom</p>
                        <h2 id="updates-title">The story starts before launch.</h2>
                    </div>
                    <div class="carousel-controls" aria-label="News carousel controls">
                        <button class="carousel-button" id="previous-news" type="button" aria-label="Previous news item">←</button>
                        <span class="carousel-count" aria-live="polite"><span id="current-news">01</span> / {String(newsItems.length).padStart(2, '0')}</span>
                        <button class="carousel-button" id="next-news" type="button" aria-label="Next news item">→</button>
                    </div>
                </div>

                <div class="news-carousel" aria-roledescription="carousel" aria-label="Red Horizon news">
                    {newsItems.map((item, index) => (
                        <article
                            class:list={['news-card', index === 0 && 'is-active']}
                            data-slide={index}
                            aria-hidden={index === 0 ? 'false' : 'true'}
                            hidden={index === 0 ? undefined : true}
                        >
                            {item.data.media ? (
                                <div class="news-image">
                                    <img
                                        src={item.data.media}
                                        alt={item.data.mediaAlt ?? ''}
                                        width="1200"
                                        height="800"
                                        loading={index === 0 ? 'eager' : 'lazy'}
                                    />
                                    <span class="image-label">{item.data.mediaLabel}</span>
                                </div>
                            ) : (
                                <div class:list={['news-placeholder', item.data.accent === 'amber' && 'placeholder-amber']} aria-hidden="true">
                                    <span class="placeholder-number">{String(index + 1).padStart(2, '0')}</span>
                                    <span class="placeholder-rule"></span>
                                    <span class="placeholder-caption">{item.data.category}</span>
                                </div>
                            )}
                            <div class="news-copy">
                                <p class="card-kicker">{item.data.category} <span>·</span> {item.data.status}</p>
                                <h3>{item.data.title}</h3>
                                <p>{item.data.summary}</p>
                                <span class="card-link">{item.data.linkLabel} <span aria-hidden="true">{index === 0 ? '↗' : '→'}</span></span>
                            </div>
                        </article>
                    ))}
                </div>
            </section>

            <section class="progress-section" id="timeline" aria-labelledby="timeline-title">
                <div class="progress-heading">
                    <p class="eyebrow">Progress log</p>
                    <h2 id="timeline-title">One step at a time.</h2>
                    <p>
                        The public story moves with the project. The highlighted step is where Red Horizon
                        is now; later milestones will be added as the record develops.
                    </p>
                </div>
                <ol class="timeline-list">
                    <li class="is-current">
                        <div class="timeline-marker"><span></span></div>
                        <div>
                            <p class="timeline-state">Current progress</p>
                            <h3>Coalition planning</h3>
                            <p>Setting the mission’s purpose, partners, and operating principles.</p>
                        </div>
                    </li>
                    <li>
                        <div class="timeline-marker"><span></span></div>
                        <div>
                            <p class="timeline-state">Next chapter</p>
                            <h3>Mission architecture</h3>
                            <p>Turning a shared objective into a testable vehicle and science plan.</p>
                        </div>
                    </li>
                    <li>
                        <div class="timeline-marker"><span></span></div>
                        <div>
                            <p class="timeline-state">Later</p>
                            <h3>Surface operations</h3>
                            <p>Using RH-01 Pathfinder to survey terrain and examine rocks in context.</p>
                        </div>
                    </li>
                </ol>
            </section>

            <aside class="disclosure" aria-label="Content disclosure">
                <div class="disclosure-mark">AI</div>
                <div>
                    <p class="disclosure-title">This is AI-generated fiction.</p>
                    <p>
                        Red Horizon is a fictional Mars mission created with AI-assisted writing, design,
                        and development. It is not affiliated with or endorsed by any real space agency.
                    </p>
                </div>
            </aside>

            <footer class="site-footer">
                <span>Red Horizon / Mars AI Simulation</span>
                <span>Built as an ongoing public experiment.</span>
            </footer>
        </main>

        <noscript>
            <style>
                .splash { display: none; }
                .page { opacity: 1; visibility: visible; }
            </style>
        </noscript>

        <script is:inline>
            const splash = document.querySelector('#splash');
            const body = document.body;
            const newsCards = Array.from(document.querySelectorAll('.news-card'));
            const currentNews = document.querySelector('#current-news');
            const previousNews = document.querySelector('#previous-news');
            const nextNews = document.querySelector('#next-news');

            window.setTimeout(() => {
                body.classList.remove('is-loading');
                body.classList.add('is-ready');
                splash?.setAttribute('hidden', '');
            }, 2000);

            let activeSlide = 0;

            const showSlide = (index) => {
                activeSlide = (index + newsCards.length) % newsCards.length;
                newsCards.forEach((card, cardIndex) => {
                    const isActive = cardIndex === activeSlide;
                    card.classList.toggle('is-active', isActive);
                    card.toggleAttribute('hidden', !isActive);
                    card.setAttribute('aria-hidden', String(!isActive));
                });
                if (currentNews) currentNews.textContent = String(activeSlide + 1).padStart(2, '0');
            };

            previousNews?.addEventListener('click', () => showSlide(activeSlide - 1));
            nextNews?.addEventListener('click', () => showSlide(activeSlide + 1));
        </script>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #010000;
        scroll-behavior: smooth;
    }

    :global(body) {
        margin: 0;
        min-width: 20rem;
        background: #010000;
        color: #fff8e8;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    }

    :global(a) {
        color: inherit;
    }

    :global(button),
    :global(a) {
        -webkit-tap-highlight-color: transparent;
    }

    .page {
        width: min(100%, 90rem);
        margin: 0 auto;
        padding: 0 4.5rem 2rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity 500ms ease;
    }

    :global(body.is-ready) .page,
    :global(body:not(.is-loading)) .page {
        opacity: 1;
        visibility: visible;
    }

    .splash {
        position: fixed;
        z-index: 20;
        inset: 0;
        display: grid;
        place-items: center;
        background: #010000;
        animation: splash-exit 500ms ease 1.5s forwards;
    }

    .splash-inner {
        display: grid;
        justify-items: center;
        gap: 0.75rem;
        text-align: center;
        animation: splash-rise 700ms ease-out both;
    }

    .splash img {
        width: clamp(7rem, 21vw, 11rem);
        height: auto;
        margin-bottom: 0.75rem;
    }

    .splash p {
        margin: 0;
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.05em;
    }

    .splash span,
    .eyebrow,
    .card-kicker,
    .timeline-state {
        color: #7ba7fa;
        font-size: 0.69rem;
        font-weight: 750;
        letter-spacing: 0.17em;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .splash span {
        color: #fca042;
    }

    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 5.5rem;
        border-bottom: 1px solid rgba(255, 248, 232, 0.13);
    }

    .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #fff8e8;
        font-size: 0.95rem;
        font-weight: 750;
        letter-spacing: -0.03em;
        text-decoration: none;
    }

    .wordmark img {
        width: 2.25rem;
        height: 2.25rem;
    }

    nav {
        display: flex;
        gap: clamp(1rem, 3vw, 2.75rem);
    }

    nav a {
        color: #dcc6b1;
        font-size: 0.78rem;
        font-weight: 650;
        text-decoration: none;
    }

    nav a:hover,
    nav a:focus-visible,
    .text-link:hover,
    .text-link:focus-visible {
        color: #fca042;
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
        align-items: center;
        gap: 4rem;
        min-height: 38rem;
        padding: 5.5rem 0 5rem;
    }

    .eyebrow {
        margin: 0 0 1.2rem;
    }

    h1,
    h2,
    h3,
    p {
        max-width: 100%;
    }

    h1,
    h2,
    h3 {
        margin: 0;
        font-weight: 720;
        letter-spacing: -0.055em;
        line-height: 0.96;
    }

    h1 {
        max-width: 39rem;
        font-size: clamp(3.6rem, 8vw, 7.8rem);
    }

    h2 {
        font-size: clamp(2.25rem, 4.8vw, 4.5rem);
    }

    h3 {
        font-size: clamp(1.7rem, 3vw, 2.8rem);
    }

    .hero-summary {
        max-width: 34rem;
        margin: 2rem 0 0;
        color: #dcc6b1;
        font-size: clamp(1rem, 1.5vw, 1.2rem);
        line-height: 1.65;
    }

    .text-link,
    .card-link {
        color: #fca042;
        font-size: 0.83rem;
        font-weight: 750;
        text-decoration: none;
    }

    .text-link {
        display: inline-flex;
        gap: 0.5rem;
        margin-top: 2rem;
        border-bottom: 1px solid rgba(252, 160, 66, 0.5);
        padding-bottom: 0.45rem;
    }

    .hero-mark {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 28rem;
    }

    .hero-mark img {
        position: relative;
        z-index: 1;
        width: min(100%, 28rem);
        height: auto;
        filter: drop-shadow(0 2rem 3rem rgba(160, 48, 29, 0.18));
    }

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(123, 167, 250, 0.32);
        border-radius: 50%;
        transform: rotate(-22deg);
    }

    .orbit-one {
        width: 90%;
        height: 45%;
    }

    .orbit-two {
        width: 73%;
        height: 75%;
        transform: rotate(50deg);
        border-color: rgba(252, 160, 66, 0.22);
    }

    .hero-coordinate {
        position: absolute;
        right: 2%;
        bottom: 8%;
        color: #7ba7fa;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        line-height: 1.6;
        text-align: right;
    }

    .mission-panel {
        display: grid;
        grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
        gap: 4rem;
        border-top: 1px solid rgba(255, 248, 232, 0.13);
        border-bottom: 1px solid rgba(255, 248, 232, 0.13);
        padding: 4.5rem 0;
    }

    .section-intro > p:last-child,
    .progress-heading > p:last-child {
        max-width: 23rem;
        margin: 1.25rem 0 0;
        color: #dcc6b1;
        font-size: 0.97rem;
        line-height: 1.6;
    }

    .mission-facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        margin: 0;
    }

    .mission-facts div {
        min-height: 7rem;
        border-left: 1px solid rgba(255, 248, 232, 0.13);
        border-bottom: 1px solid rgba(255, 248, 232, 0.13);
        padding: 0 1.5rem 1.5rem;
    }

    .mission-facts div:nth-child(2n) {
        border-left: 0;
    }

    .mission-facts .fact-wide {
        grid-column: 1 / -1;
        min-height: auto;
        border-left: 0;
        border-bottom: 0;
        padding-top: 1.5rem;
    }

    dt {
        color: #7ba7fa;
        font-size: 0.68rem;
        font-weight: 750;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    dd {
        margin: 0.8rem 0 0;
        color: #fff8e8;
        font-size: clamp(1.1rem, 1.8vw, 1.5rem);
        font-weight: 650;
        line-height: 1.2;
    }

    .fact-wide dd {
        max-width: 37rem;
        color: #dcc6b1;
        font-size: 1.02rem;
        font-weight: 450;
        line-height: 1.55;
    }

    .news-section,
    .progress-section {
        padding: 7rem 0;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 2.75rem;
    }

    .section-heading h2 {
        max-width: 35rem;
    }

    .carousel-controls {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        flex-shrink: 0;
    }

    .carousel-button {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border: 1px solid rgba(255, 248, 232, 0.35);
        border-radius: 50%;
        background: transparent;
        color: #fff8e8;
        font: inherit;
        font-size: 1.05rem;
        cursor: pointer;
    }

    .carousel-button:hover,
    .carousel-button:focus-visible {
        border-color: #fca042;
        background: #fca042;
        color: #010000;
    }

    .carousel-count {
        color: #dcc6b1;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
    }

    #current-news {
        color: #fca042;
    }

    .news-card {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
        min-height: 27rem;
        background: #17110f;
    }

    .news-image,
    .news-placeholder {
        position: relative;
        min-height: 22rem;
        overflow: hidden;
        background: #eeebe5;
    }

    .news-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-label {
        position: absolute;
        right: 1.25rem;
        bottom: 1.15rem;
        max-width: calc(100% - 2.5rem);
        background: rgba(1, 0, 0, 0.78);
        padding: 0.45rem 0.6rem;
        color: #fff8e8;
        font-size: 0.63rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .news-placeholder {
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #9f321f;
        padding: 3rem;
    }

    .placeholder-amber {
        background: #fcc78b;
        color: #010000;
    }

    .placeholder-number {
        font-size: clamp(7rem, 17vw, 14rem);
        font-weight: 750;
        letter-spacing: -0.1em;
        line-height: 0.75;
        opacity: 0.9;
    }

    .placeholder-rule {
        width: 55%;
        margin-top: 2rem;
        border-top: 2px solid currentColor;
        opacity: 0.5;
    }

    .placeholder-caption {
        margin-top: 0.75rem;
        font-size: 0.68rem;
        font-weight: 750;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .news-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: clamp(2rem, 5vw, 4.5rem);
    }

    .card-kicker {
        margin: 0 0 1.6rem;
        color: #fca042;
    }

    .card-kicker span {
        color: #dcc6b1;
    }

    .news-copy h3 {
        max-width: 24rem;
    }

    .news-copy p:not(.card-kicker) {
        max-width: 27rem;
        margin: 1.5rem 0 0;
        color: #dcc6b1;
        font-size: 1rem;
        line-height: 1.65;
    }

    .card-link {
        display: inline-flex;
        gap: 0.5rem;
        margin-top: 2rem;
    }

    .progress-section {
        display: grid;
        grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
        gap: 4rem;
        border-top: 1px solid rgba(255, 248, 232, 0.13);
    }

    .timeline-list {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .timeline-list li {
        position: relative;
        display: grid;
        grid-template-columns: 2rem 1fr;
        gap: 1.2rem;
        min-height: 8.5rem;
        padding-bottom: 2rem;
    }

    .timeline-list li:not(:last-child)::after {
        position: absolute;
        top: 1.1rem;
        bottom: 0;
        left: 0.47rem;
        border-left: 1px solid rgba(255, 248, 232, 0.3);
        content: '';
    }

    .timeline-marker {
        position: relative;
        z-index: 1;
        display: grid;
        width: 1rem;
        height: 1rem;
        place-items: center;
        margin-top: 0.25rem;
        border: 1px solid #7ba7fa;
        border-radius: 50%;
        background: #010000;
    }

    .timeline-marker span {
        width: 0.32rem;
        height: 0.32rem;
        border-radius: 50%;
        background: #7ba7fa;
    }

    .timeline-list li.is-current .timeline-marker {
        border-color: #fca042;
        box-shadow: 0 0 0 0.4rem rgba(252, 160, 66, 0.12);
    }

    .timeline-list li.is-current .timeline-marker span {
        background: #fca042;
    }

    .timeline-state {
        margin: 0 0 0.55rem;
        color: #fca042;
    }

    .timeline-list h3 {
        font-size: clamp(1.35rem, 2.6vw, 2rem);
        letter-spacing: -0.04em;
    }

    .timeline-list li > div:last-child > p:last-child {
        max-width: 30rem;
        margin: 0.7rem 0 0;
        color: #dcc6b1;
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .disclosure {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        border: 1px solid rgba(252, 199, 139, 0.38);
        background: rgba(252, 160, 66, 0.08);
        padding: 1.1rem 1.25rem;
    }

    .disclosure-mark {
        display: grid;
        width: 2.7rem;
        height: 2.7rem;
        flex: 0 0 auto;
        place-items: center;
        border: 1px solid #fca042;
        border-radius: 50%;
        color: #fca042;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .disclosure p {
        margin: 0;
        color: #dcc6b1;
        font-size: 0.79rem;
        line-height: 1.45;
    }

    .disclosure .disclosure-title {
        margin-bottom: 0.15rem;
        color: #fff8e8;
        font-weight: 750;
    }

    .site-footer {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 2.5rem 0 0.5rem;
        color: #7e7067;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    :global(a:focus-visible),
    :global(button:focus-visible) {
        outline: 2px solid #7ba7fa;
        outline-offset: 4px;
    }

    @keyframes splash-rise {
        from { opacity: 0; transform: translateY(0.8rem); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes splash-exit {
        to { opacity: 0; visibility: hidden; }
    }

    @media (max-width: 760px) {
        .page {
            padding: 0 1.25rem 1.25rem;
        }

        .site-header {
            min-height: 4.75rem;
        }

        nav {
            gap: 0.85rem;
        }

        nav a {
            font-size: 0.7rem;
