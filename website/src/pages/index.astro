---
import Hero from '../features/mission/Hero.astro';
import MissionPanel from '../features/mission/MissionPanel.astro';
import NewsCarousel from '../features/news/NewsCarousel.astro';
import ProgressLog from '../features/progress/ProgressLog.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/*
  * The homepage is the one route that opts into the splash: `splash` renders the
  * loading screen and holds the page back until it retracts. Every other route
  * omits it and is revealed by CSS, with no 2 s wait.
  */}
<BaseLayout splash>
    <Hero />
    <MissionPanel />
    <NewsCarousel />
    <ProgressLog />
</BaseLayout>
