---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import { resolveNewsMedia } from '../../../features/news/media';
import MediaPlates from '../../../features/news/MediaPlates.astro';
import { isPlateSet, plateAltText } from '../../../features/news/plates';
import { getPublishedWiki } from '../../../features/wiki/query';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isNewsMediaKey } from '../../../lib/media';
import { routes } from '../../../lib/navigation';
import { site } from '../../../lib/site';
import { selectRelatedWiki } from '../../../lib/wiki-query';

/**
 * One published wiki page: its title and summary, the media its `media:` key
 * resolves to, its MDX body, and the cross-links its `related:` list names.
 *
 * One route per published page — the same selection the indexes list, so a
 * draft page has no route here at all and no card can link to one. The media
 * path is the news one (`resolveNewsMedia` over the keys `src/lib/media.ts`
 * validates), so a plate set renders as a plate block rather than dropping
 * every plate but the first.
 *
 * `related` is resolved against the published selection, so an id naming an
 * unknown or withheld page renders no link instead of a dead one.
 */
export async function getStaticPaths() {
    const entries = await getPublishedWiki();
    return entries.map((entry) => ({ params: { section: entry.data.section, slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
/**
 * The schema already rejects a `media:` value that is not a known key
 * (`src/lib/media.ts`), so this narrowing is what the type system asks for
 * rather than a second validation: an unknown key resolves to no media instead
 * of to a broken image.
 */
const declaredMedia = entry.data.media;
const media = declaredMedia && isNewsMediaKey(declaredMedia) ? resolveNewsMedia(declaredMedia) : undefined;
const plateSet = media ? isPlateSet(media) : false;
const leadPlate = media?.plates[0];
const related = selectRelatedWiki(await getPublishedWiki(), entry.data.related);
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | ${site.name}`} description={entry.data.summary}>
    <article class="wiki-page" aria-labelledby="wiki-title">
        <p class="wiki-breadcrumb">
            <a href={routes.wiki}>{site.name} wiki</a>
            <span>·</span>
            <a href={routes.wikiSection(entry.data.section)}>{entry.data.section}</a>
        </p>
        <header class="wiki-header">
            <h1 id="wiki-title">{entry.data.title}</h1>
            <p class="wiki-summary">{entry.data.summary}</p>
        </header>

        {media && leadPlate && !plateSet && (
            <figure class="wiki-media">
                <Image
                    src={leadPlate.src}
                    alt={plateAltText({ value: entry.data.mediaAlt, plates: media.plates, index: 0 })}
                    width={1024}
                    format="webp"
                    loading="eager"
                />
                {entry.data.mediaLabel && <figcaption>{entry.data.mediaLabel}</figcaption>}
            </figure>
        )}

        {media && plateSet && (
            <MediaPlates
                set={media}
                mediaAlt={entry.data.mediaAlt}
                mediaCaption={entry.data.mediaCaption}
                mediaLabel={entry.data.mediaLabel}
            />
        )}

        <div class="wiki-body">
            <Content />
        </div>

        {related.length > 0 && (
            <nav class="wiki-related" aria-label="Related wiki pages">
                <ul>
                    {related.map((page) => (
                        <li>
                            <a href={routes.wikiPage(page.data.section, page.id)}>{page.data.title}</a>
                        </li>
                    ))}
                </ul>
            </nav>
        )}
    </article>
</BaseLayout>

<style>
.wiki-page {
    padding: 5rem 0 7rem;
}

.wiki-breadcrumb {
    margin: 0 0 1.5rem;
    color: var(--rh-text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.wiki-breadcrumb a {
    color: var(--rh-text-muted);
    text-decoration: none;
}

.wiki-breadcrumb a:hover,
.wiki-breadcrumb a:focus-visible {
    color: var(--rh-sun-core);
}

.wiki-header {
    max-width: 44rem;
    border-bottom: 1px solid var(--rh-hairline);
    padding-bottom: 2.5rem;
}

.wiki-header h1 {
    max-width: 40rem;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
}

.wiki-summary {
    max-width: 38rem;
    margin: 1.75rem 0 0;
    color: var(--rh-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
}

.wiki-media {
    max-width: 44rem;
    margin: 3rem 0 0;
}

.wiki-media img {
    width: 100%;
    max-width: 24rem;
    height: auto;
}

.wiki-media figcaption {
    margin-top: 0.85rem;
    color: var(--rh-text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.wiki-body {
    max-width: 44rem;
    margin-top: 3rem;
}

.wiki-body :global(h2) {
    margin: 3rem 0 0;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
}

.wiki-body :global(h3) {
    margin: 2.25rem 0 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
}

.wiki-body :global(p),
.wiki-body :global(li) {
    color: var(--rh-text-muted);
    font-size: 1rem;
    line-height: 1.7;
}

.wiki-body :global(p) {
    margin: 1.15rem 0 0;
}

.wiki-body :global(ul) {
    margin: 1.15rem 0 0;
    padding-left: 1.25rem;
}

.wiki-body :global(li + li) {
    margin-top: 0.5rem;
}

.wiki-body :global(a) {
    color: var(--rh-sun-core);
}

.wiki-related {
    max-width: 44rem;
    margin-top: 3.5rem;
    border-top: 1px solid var(--rh-hairline);
    padding-top: 1.5rem;
}

.wiki-related ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    gap: 1.5rem;
    list-style: none;
}

.wiki-related a {
    border-bottom: 1px solid rgba(252, 160, 66, 0.5);
    padding-bottom: 0.35rem;
    color: var(--rh-sun-core);
    font-size: 0.83rem;
    font-weight: 750;
    text-decoration: none;
}

.wiki-related a:hover,
.wiki-related a:focus-visible {
    color: var(--rh-rim-light);
}

@media (max-width: 760px) {
    .wiki-page {
        padding: 4rem 0 4.5rem;
    }
}
</style>
