---
import '../styles/global.css';

import DisclosureNote from '../components/DisclosureNote.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SplashScreen from '../components/SplashScreen.astro';
import { canonicalUrl } from '../lib/seo';
import { site } from '../lib/site';

/**
 * Site shell: document head, optional splash, page column, and the chrome a page
 * composes around its own sections. `title` and `description` default to the site
 * strings already in use.
 *
 * `noindex` is the head opt-out the error route needs: it suppresses the
 * canonical link (the pathname an error page is served under is not a URL the
 * document owns) and marks the page `robots: noindex`. `404.astro` is the only
 * page that sets it — no other route may.
 *
 * `splash` is the homepage's opt-in for the loading screen: it decides both the
 * `<SplashScreen />` element and the `is-loading` body class that holds the page
 * back until the splash retracts. It defaults to `false`, so a route that says
 * nothing inherits no splash and is revealed by CSS alone (`layout.css`).
 * `src/pages/index.astro` is the only page that sets it, which is what keeps the
 * splash on exactly `/` — the gate is a prop, not a pathname comparison, so it
 * cannot misfire under `trailingSlash: 'always'`, `build.format`, or a differently
 * normalised `Astro.url.pathname` during the build.
 *
 * The prop decides *whether a document may splash*; the inline script below
 * decides whether *this* landing does. A fragment landing on the homepage is a
 * first-class entry URL — the header, the footer and the hero link into
 * `/#mission`, `/#top`, `/#timeline` and `#updates` — and a visitor following one
 * must not sit behind the loading screen: the browser needs to perform the
 * fragment jump, and the 2 s splash would hold `.page` back (`opacity: 0`,
 * `visibility: hidden`) while showing a screen that is not their destination. So
 * the script sets `data-splash-skip` on `<html>` for any non-empty
 * `location.hash`, and for a document served at a path other than `/`. It runs
 * in `<head>`, during parse, before the splash markup exists, so nothing is ever
 * painted: no flash, no retraction to wait for. `layout.css` keys on the marker
 * attribute to hide `.splash` and reveal `.page`, and `scripts/splash-scope.mjs`
 * fails the build when the marker or its stylesheet rule goes missing.
 */
const { title = site.defaultTitle, description = site.defaultDescription, noindex = false, splash = false } =
    Astro.props;

const canonical = noindex ? undefined : canonicalUrl(Astro.url.pathname, Astro.site);

/**
 * The homepage's pre-paint fragment gate, emitted inline into `<head>` (the
 * reasoning is in the note above). `set:html` writes the string into the
 * document byte-for-byte, so the decision runs during parse, with no request of
 * its own and no flash to undo.
 */
const splashGate = `if (location.pathname !== '/' || location.hash) {
    document.documentElement.setAttribute('data-splash-skip', '');
}`;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        {splash && <script is:inline set:html={splashGate} />}
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
        <link rel="icon" href="/assets/favicon.ico" sizes="any" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        {canonical && <link rel="canonical" href={canonical} />}
        {noindex && <meta name="robots" content="noindex" />}
        <title>{title}</title>
    </head>
    <body class={splash ? 'is-loading' : undefined}>
        {splash && <SplashScreen />}

        <main id="main-content" class="page">
            <slot name="header">
                <SiteHeader />
            </slot>
            <slot />
            <slot name="disclosure">
                <DisclosureNote />
            </slot>
            <slot name="footer">
                <SiteFooter />
            </slot>
        </main>

        <noscript>
            <style>
            /*
             * Without JavaScript the splash never retracts and the page
             * fade never runs, so both are forced off. `!important` is
             * required: the layout rule that reveals the page is more
             * specific than a bare `.page` selector.
             */
            .splash {
                display: none !important;
            }
            .page {
                opacity: 1 !important;
                visibility: visible !important;
            }
            </style>
        </noscript>
    </body>
</html>
