{
    "name": "website",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "predev": "node scripts/sync-assets.mjs",
        "prebuild": "node scripts/sync-assets.mjs",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "format": "prettier --write 'src/**/*.astro' 'scripts/**/*.mjs' '*.config.mjs' 'eslint.config.js' 'tsconfig.json' 'package.json' 'wrangler.jsonc'",
        "format:check": "prettier --check 'src/**/*.astro' 'scripts/**/*.mjs' '*.config.mjs' 'eslint.config.js' 'tsconfig.json' 'package.json' 'wrangler.jsonc'",
        "lint": "eslint .",
        "typecheck": "astro check",
        "test": "vitest run"
    },
    "dependencies": {
        "astro": "^7.3.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^9.39.5",
        "@vitest/ui": "^5.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-astro": "^1.7.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1",
        "wrangler": "4.132.0"
    }
}
