# Model files, credentials and machine-specific state never belong in this repository.
*.safetensors
*.ckpt
*.pt
*.pth
.env
.env.*
.DS_Store
__pycache__/
*.py[cod]

# This tool keeps no permanent assets. Everything it generates is scratch: copy approved
# reference images in from docs/ before a run, and copy a human-selected result back into
# docs/ with its asset manifest. Any of the paths below may be deleted at any time.
spec.json
assets/
stories/
logs/
tests-output/
*.history.json
*.inputs.json
*.job.json
*.png
*.jpg
*.jpeg
*.tar
*.zip
